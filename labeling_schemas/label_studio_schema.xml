<View>
  <View style="display: flex; gap: 20px; margin-bottom: 20px;">
    <View style="flex: 1;">
      <Header value="UAV / aerial view (roof and surroundings)"/>
      <Image name="uav_view" value="$uav_image" maxWidth="100%"/>
    </View>
    <View style="flex: 1;">
      <Header value="Street view (facade)"/>
      <Image name="svi_view" value="$streetview_image" maxWidth="100%"/>
    </View>
  </View>

  <Text name="meta" value="OSM ID: $osm_id"/>

  <Header value="structural_openness"/>
  <Choices name="structural_openness" toName="uav_view" choice="single" showInline="true">
    <Choice value="closed_structure"/>
    <Choice value="open_structure"/>
    <Choice value="unknown"/>
  </Choices>

  <Header value="number_of_floors"/>
  <Choices name="number_of_floors" toName="svi_view" choice="single" showInline="true">
    <Choice value="one"/>
    <Choice value="two"/>
    <Choice value="three_or_more"/>
    <Choice value="unknown"/>
  </Choices>

  <Header value="vegetation (trees / canopy around the building)"/>
  <Choices name="vegetation" toName="uav_view" choice="single" showInline="true">
    <Choice value="yes"/>
    <Choice value="no"/>
  </Choices>

  <Header value="material_rooftop"/>
  <Choices name="material_rooftop" toName="uav_view" choice="single" showInline="true">
    <Choice value="concrete"/>
    <Choice value="metal"/>
    <Choice value="tile"/>
    <Choice value="asbestos"/>
    <Choice value="thatch_wood"/>
    <Choice value="other"/>
    <Choice value="unknown"/>
  </Choices>

  <Header value="material_wall"/>
  <Choices name="material_wall" toName="svi_view" choice="single" showInline="true">
    <Choice value="concrete"/>
    <Choice value="brick"/>
    <Choice value="metal"/>
    <Choice value="wood"/>
    <Choice value="glass"/>
    <Choice value="other"/>
    <Choice value="unknown"/>
  </Choices>
</View>
